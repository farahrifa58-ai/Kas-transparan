rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPublicKasId(id) {
      return id is string && id.size() >= 7 && id.size() <= 32 && id.matches('^KAS-[A-Z0-9]{4,28}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.amount is int && data.amount >= 0 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             data.date is string && data.date.size() == 10 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100)) &&
             (!('receiptUrl' in data) || (data.receiptUrl is string && data.receiptUrl.size() <= 2000)) &&
             data.status in ['ACTIVE', 'VOID'] &&
             (!('voidReason' in data) || (data.voidReason is string && data.voidReason.size() <= 500));
    }

    function isValidSettings(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 200 &&
             (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.initialBalance is int &&
             data.currencyCode is string && data.currencyCode.size() >= 3 && data.currencyCode.size() <= 5 &&
             data.language is string && data.language.size() >= 2 && data.language.size() <= 10 &&
             (!('themeMode' in data) || data.themeMode in ['SYSTEM', 'LIGHT', 'DARK']) &&
             (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 2000)) &&
             (!('publicKasId' in data) || (data.publicKasId is string && data.publicKasId.size() <= 32)) &&
             (!('writeSecret' in data) || (data.writeSecret is string && data.writeSecret.size() <= 64)) &&
             (!('publicAutoSync' in data) || data.publicAutoSync is bool) &&
             (!('publicLastSyncedAt' in data) || data.publicLastSyncedAt is int) &&
             (!('publicBaseUrl' in data) || (data.publicBaseUrl is string && data.publicBaseUrl.size() <= 500));
    }

    function isValidAuditLog(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.transactionId is string && data.transactionId.size() <= 128 &&
             data.action in ['CREATE', 'UPDATE', 'VOID'] &&
             data.details is string && data.details.size() <= 2000 &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 500));
    }

    function isValidPublicKas(data) {
      return data.keys().hasAll(['writeSecret', 'groupName', 'totalBalance', 'totalIncome', 'totalExpense', 'updatedAt', 'transactions']) &&
             data.keys().hasOnly(['writeSecret', 'ownerUid', 'groupName', 'description', 'currencyCode', 'initialBalance', 'totalBalance', 'totalIncome', 'totalExpense', 'updatedAt', 'transactions']) &&
             data.writeSecret is string && data.writeSecret.size() >= 16 && data.writeSecret.size() <= 64 &&
             (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('currencyCode' in data) || (data.currencyCode is string && data.currencyCode.size() >= 3 && data.currencyCode.size() <= 5)) &&
             (!('initialBalance' in data) || data.initialBalance is int) &&
             data.totalBalance is int &&
             data.totalIncome is int && data.totalIncome >= 0 &&
             data.totalExpense is int && data.totalExpense >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.transactions is list && data.transactions.size() <= 2000 &&
             (data.transactions.size() == 0 || data.transactions[0] is map);
    }

    // Public Read-Only Cash Transparency Reports (1-Link Citizen Viewer + Group Write Secret Protection)
    match /public_kas/{publicKasId} {
      // Anyone with the exact KAS-XXXXXXXX ID can view read-only without signing in; listing all groups is forbidden
      allow get: if isValidPublicKasId(publicKasId);
      allow list: if false;

      // Treasurer creates a new public report directly without login, establishing the immutable 24-char writeSecret
      allow create: if isValidPublicKasId(publicKasId) &&
                       isValidPublicKas(incoming());

      // Only the holder of the matching immutable writeSecret can update this publicKasId document
      allow update: if isValidPublicKasId(publicKasId) &&
                       isValidPublicKas(incoming()) &&
                       (
                         ('writeSecret' in existing() &&
                          existing().writeSecret is string &&
                          incoming().writeSecret == existing().writeSecret) ||
                         (!('writeSecret' in existing()) &&
                          isSignedIn() &&
                          existing().ownerUid == request.auth.uid)
                       );

      // Disallow arbitrary deletion of published public reports
      allow delete: if false;
    }

    // 1-Device License Activation Codes (supports lookup by doc ID or code field, auto-restore by deviceId, and safe 1-device claiming)
    match /activation_codes/{docId} {
      allow get: if isValidId(docId);
      allow list: if request.query.limit != null && request.query.limit <= 10;

      // Only signed-in admins can create new license records directly via client SDK
      allow create: if isSignedIn() && isValidId(docId);

      // Device activation update: can only claim an eligible non-revoked code that is unbound or already bound to the same deviceId
      allow update: if isValidId(docId) &&
                       (!('status' in existing()) || !(existing().status in ['revoked', 'blocked', 'disabled', 'suspended'])) &&
                       (!('status' in existing()) || existing().status != 'used' || ('deviceId' in existing() && existing().deviceId == incoming().deviceId)) &&
                       (!('deviceId' in existing()) || existing().deviceId == null || existing().deviceId == '' || existing().deviceId == incoming().deviceId) &&
                       incoming().status == 'active' &&
                       incoming().deviceId is string && incoming().deviceId.size() >= 4 && incoming().deviceId.size() <= 128 &&
                       incoming().activatedAt is timestamp && incoming().activatedAt <= request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deviceId', 'activatedAt']);

      allow delete: if false;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && incoming().userId == request.auth.uid;
      allow delete: if false;

      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(settingId) &&
                         isValidSettings(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(settingId) &&
                         isValidSettings(incoming()) &&
                         incoming().userId == existing().userId;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /audit_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidAuditLog(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update, delete: if false;
      }
    }
  }
}
